# Tailscale OAuth (used by docktail)
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=

# Ryot admin token and Postgres superuser password
SERVER_ADMIN_ACCESS_TOKEN=change_me_to_a_long_random_string
POSTGRES_PASSWORD=replace_with_postgres_superuser_password
RYOT_PASSWORD=replace_with_ryot_db_password


